# Definitive Flash API key.
#
# Works immediately with the public integrator key from Definitive's docs
# (good enough to build and record a demo):
FLASH_API_KEY=dpka_513a2bd7_57a2_46d2_927b_2a3857fe271b
#
# For your own org as the integrator — so integrator fees accrue to YOU:
#   1. app.definitive.fi -> More -> Flash -> Create Flash Key
#   2. paste it here
#
# NEVER commit a real key, and never expose it to the browser. All Flash
# calls go through /api/* routes so the key stays server-side.

# Optional: your Base builder code from base.dev, stamped onto settlement
# transactions via ERC-8021 (order-only, no pricing effect). Free attribution.
# ERC8021_ATTRIBUTION_CODE=nightdesk

# Integrator fee in basis points, charged on every order and shown to users.
# "25" = 0.25%. Definitive's own 10bps launch fee stacks on top.
INTEGRATOR_FEE_BPS=25

# Hard ceiling on any single order, regardless of the percentage chosen.
# For a tiny mechanics-only smoke test, set this BELOW MIN_SPEND_USD (e.g. 0.5):
# MAX wins the clamp and the floor guard follows it down.
# For the recorded demo, 25-50 reads better on camera and the fee drops under 0.5%.
MAX_SPEND_USD=250

# Policy floor. Flash's own floor is ~$0.03 (measured — see TESTING.md), but
# every quote carries a fixed ~$0.03 of network/route cost, so small trades are
# mostly fee: 11% at $0.25, 3.9% at $1, 0.88% at $5.
MIN_SPEND_USD=1

# DRY RUN — rehearse the whole flow with REAL quotes but no approvals, no
# signatures and no submission. Nothing is spent, nothing lands onchain.
#
#   1 = rehearsal  (a loud banner appears on every page)
#   0 = armed      (real orders)
#
# There is no testnet (see TESTING.md), so this is how you rehearse for free.
#
# Defaults to 1 (rehearsal) because that is the safe way to meet this repo: clone
# it, run it, walk the whole mirror flow with real quotes and real signatures,
# and spend nothing. Set it to 0 only when you intend to place real orders.
NEXT_PUBLIC_DRY_RUN=1

# ---------------------------------------------------------------------------
# Author earnings
# ---------------------------------------------------------------------------

# The fee that makes the author share possible is INTEGRATOR_FEE_BPS (above).
# Flash pays ONE integrator per order and cannot split a fee across the many
# authors whose plans get mirrored, so the author share is settled off-chain by
# /api/earnings as a plain USDC transfer. See src/lib/earnings.ts.
#
# The percentage of our integrator fee that goes to the plan's author.
AUTHOR_SHARE_PCT=60

# Gate for POST /api/earnings {action: "settle"}, which marks a balance as paid.
#
#   armed  (NEXT_PUBLIC_DRY_RUN=0)  -> REQUIRED. With no token set, settling is
#                                      refused outright rather than left open.
#   dry run                         -> optional, so the payout flow can be walked
#                                      end to end without touching real money.
#
# Uncomment and set a long random value before deploying anything armed.
# OPERATOR_TOKEN=change-me-to-something-long-and-random
